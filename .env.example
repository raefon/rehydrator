POSTGRES_URL=postgres://user:pass@postgres:5432/tenantdb?sslmode=disable
TENANT_NAME=tenet-nofear101

RADARR_URL=http://tenet-radarr:7878
RADARR_API_KEY=replace_me

SONARR_URL=http://tenet-sonarr:8989
SONARR_API_KEY=replace_me
SONARR_SYNC_ENABLED=false
SONARR_SYNC_INTERVAL_SECONDS=60

SEERR_URL=http://tenet-seerr:5055
SEERR_API_KEY=replace_me
SEERR_SYNC_ENABLED=false
SEERR_SYNC_INTERVAL_SECONDS=120
SEERR_SYNC_LIMIT=100

DECYPHARR_API_TOKEN=
DECYPHARR_URL=http://tenet-decypharr:8282
DECYPHARR_USERNAME=
DECYPHARR_PASSWORD=
DECYPHARR_RADARR_CATEGORY=radarr
DECYPHARR_SONARR_CATEGORY=sonarr
DECYPHARR_DELETE_FILES_ON_PRUNE=false

# Decypharr owns provider operations; TorBox credentials belong in Decypharr.
REARM_BACKEND=decypharr

CSI_PATH=/storage/media
HEALTH_ADDR=:8080
API_ENABLED=true
API_TOKEN=replace_me
API_REQUIRE_TOKEN=true
METRICS_ENABLED=true
PLAYBACK_ENABLED=true
PLAYBACK_REARM_ON_PLAY=true
PLAYBACK_COOLDOWN_SECONDS=60
PLAYBACK_IGNORED_TITLES=
PLAYBACK_IGNORED_TITLE_CONTAINS=
RADARR_SYNC_ENABLED=true
RADARR_SYNC_INTERVAL_SECONDS=60
PRUNE_ENABLED=true
REARM_ENABLED=true
MAX_PRUNES_PER_RUN=5
MAX_REARMS_PER_RUN=3
PRUNE_WAIT_FOR_CSI_GONE=false
REARM_SHORT_CIRCUIT_IF_CSI_VISIBLE=false

RECONCILE_INTERVAL_SECONDS=30
CSI_WAIT_SECONDS=900
CSI_VISIBILITY_TIMEOUT_SECONDS=900
CSI_VISIBILITY_POLL_SECONDS=10
CSI_VISIBILITY_RETRY_SECONDS=60
PROVIDER_COOLDOWN_SECONDS=900
RCLONE_RC_ENABLED=false
RCLONE_RC_URL=http://localhost:5572
RCLONE_RC_USERNAME=
RCLONE_RC_PASSWORD=
RCLONE_RC_REFRESH_AFTER_REARM=false
RCLONE_RC_TIMEOUT_SECONDS=10
CACHE_GRACE_HOURS=24
MAX_RETRIES=10
CONCURRENT_WORKERS=2
DB_AUTO_MIGRATE=false


# Self-heal / operational repair
SELF_HEAL_ENABLED=true
SELF_HEAL_INTERVAL_SECONDS=300
SELF_HEAL_REFRESH_AVAILABLE=true
SELF_HEAL_RECENT_HOURS=24
SELF_HEAL_MAX_REFRESHES_PER_RUN=5

# Optional Jellyfin integration
JELLYFIN_ENABLED=false
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=
JELLYFIN_REFRESH_AFTER_REARM=true
JELLYFIN_REFRESH_AFTER_VISIBILITY=true
JELLYFIN_REFRESH_AFTER_IMPORT=true
JELLYFIN_REFRESH_AFTER_PRUNE=false
JELLYFIN_REFRESH_DELAY_SECONDS=45
JELLYFIN_TIMEOUT_SECONDS=20

JELLYFIN_MAX_REFRESHES_PER_RUN=5
JELLYFIN_REFRESH_DEDUPE_MINUTES=10

# notification or targeted_scan (requires Jellyfin Targeted Scans plugin)
JELLYFIN_REFRESH_MODE=notification

# Rolling torrent-only file-read checks; excludes NZB/Usenet and archived items.
FILE_HEALTH_ENABLED=true
FILE_HEALTH_INTERVAL_SECONDS=300
FILE_HEALTH_BATCH_SIZE=20
FILE_HEALTH_FAILURE_THRESHOLD=3
FILE_HEALTH_MAX_REARMS_PER_RUN=2
FILE_HEALTH_PROBE_TIMEOUT_SECONDS=5
FILE_HEALTH_OUTAGE_FAILURE_PERCENT=50
FILE_HEALTH_CANARY_PATH=

# Optional direct read-only TorBox account inventory checks. Mutations stay in Decypharr.
TORBOX_HEALTH_ENABLED=false
TORBOX_HEALTH_API_KEY=
TORBOX_HEALTH_INTERVAL_SECONDS=900
TORBOX_HEALTH_TIMEOUT_SECONDS=20

# Compare imported movie/episode paths with Jellyfin's index; no local file probes.
JELLYFIN_INVENTORY_SYNC_ENABLED=true
JELLYFIN_INVENTORY_SYNC_INTERVAL_SECONDS=1800
JELLYFIN_INVENTORY_SYNC_MAX_REFRESHES_PER_RUN=5
JELLYFIN_INVENTORY_SYNC_COOLDOWN_MINUTES=360
